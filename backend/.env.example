APP_NAME=Permanent ANPR Parking
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

DATABASE_URL=postgresql+psycopg://parking:parking_change_me@db:5432/parking

MODEL_PATH=/app/models/best.pt
SCAN_STORAGE_DIR=/app/data/scans
ANPR_CONFIDENCE=0.35
OCR_MIN_CONFIDENCE=0.20
MAX_UPLOAD_MB=12

ALLOW_UNREGISTERED_VEHICLES=true

GRACE_MINUTES=15
FIRST_HOUR_CENTS=200
NEXT_HOUR_CENTS=100
DAILY_CAP_CENTS=2000

CORS_ORIGINS=*
